# Copy to .env (local) or set in Vercel > Settings > Environment Variables. Leave anything you don't need blank.

# Control plane (/admin). Locally with no password set, /admin is open on localhost only.
ADMIN_PASSWORD=
# any long random string; signs the login cookie (falls back to the password)
ADMIN_SECRET=

# Publish from /admin on the live site: commits changes to GitHub, then Vercel rebuilds.
# Token: a fine-grained personal access token with "Contents: read and write" on this repo.
GITHUB_TOKEN=
GITHUB_REPO=tejvirmann/my-website
GITHUB_BRANCH=main

# Shop checkout (later)
STRIPE_SECRET_KEY=
