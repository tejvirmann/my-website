---
// Suminagashi: touch or click drops ink that pushes the rings around it; drag to pull the ink with a comb
interface Props { palette?: string }
const { palette = 'sumi' } = Astro.props
---

<section class="wild ink" data-palette={palette} aria-label="Interactive ink">
  <canvas></canvas>
  <p class="hint">Click to drop ink. Drag to pull it.</p>
</section>

<style is:global>
  .wild.ink { min-height: min(78vh, 640px); background: #f1ece0; color: #14141a }
  .wild.ink canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; cursor: crosshair }
  .wild.ink .hint { position: absolute; left: var(--gut); bottom: 14px; margin: 0; font-size: 12px; letter-spacing: .04em; opacity: .55; pointer-events: none }
</style>

<script>
  const PAL: Record<string, { bg: string; inks: string[] }> = {
    sumi: { bg: '#f1ece0', inks: ['#14141a'] },
    indigo: { bg: '#eef0f2', inks: ['#1b2a6b', '#3a63d1'] },
    rose: { bg: '#f6efe9', inks: ['#8c1d40', '#d85c80', '#2a1520'] },
    moss: { bg: '#eef0e4', inks: ['#1f3d2b', '#5b8a4a'] },
  }
  const N = 96, MAX = 70
  type Drop = { p: Float32Array; c: string }
  document.querySelectorAll<HTMLElement>('.wild.ink').forEach(root => {
    const cv = root.querySelector('canvas')!
    const ctx = cv.getContext('2d')!
    const pal = PAL[root.dataset.palette ?? 'sumi'] ?? PAL.sumi
    root.style.background = pal.bg
    const drops: Drop[] = []
    let w = 0, h = 0, dirty = true, n = 0, visible = false
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches

    const size = () => {
      const r = root.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1)
      w = r.width; h = r.height
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      dirty = true
    }
    // a new drop of radius r pushes every existing point away from its center (area-preserving marbling)
    const drop = (cx: number, cy: number, r: number) => {
      for (const d of drops) for (let i = 0; i < N; i++) {
        const dx = d.p[2 * i] - cx, dy = d.p[2 * i + 1] - cy, f = Math.sqrt(1 + (r * r) / (dx * dx + dy * dy + 0.01))
        d.p[2 * i] = cx + dx * f; d.p[2 * i + 1] = cy + dy * f
      }
      const p = new Float32Array(N * 2)
      for (let i = 0; i < N; i++) { const a = (i / N) * Math.PI * 2; p[2 * i] = cx + Math.cos(a) * r; p[2 * i + 1] = cy + Math.sin(a) * r }
      // inks alternate with water (the paper color), which is what makes the rings
      drops.push({ p, c: n++ % 2 ? pal.bg : pal.inks[Math.floor(n / 2) % pal.inks.length] })
      if (drops.length > MAX) drops.shift()
      dirty = true
    }
    // pull the ink along the drag direction, strongest near the path
    const comb = (x: number, y: number, dx: number, dy: number) => {
      const len = Math.hypot(dx, dy)
      if (len < 1) return
      const ux = dx / len, uy = dy / len, nx = -uy, ny = ux, L = 46
      for (const d of drops) for (let i = 0; i < N; i++) {
        const px = d.p[2 * i] - x, py = d.p[2 * i + 1] - y, dist = Math.abs(px * nx + py * ny), k = Math.exp(-(dist * dist) / (2 * L * L)) * Math.exp(-Math.abs(px * ux + py * uy) / 160)
        d.p[2 * i] += ux * len * k; d.p[2 * i + 1] += uy * len * k
      }
      dirty = true
    }
    const draw = () => {
      ctx.fillStyle = pal.bg
      ctx.fillRect(0, 0, w, h)
      for (const d of drops) {
        ctx.fillStyle = d.c
        ctx.beginPath()
        ctx.moveTo(d.p[0], d.p[1])
        for (let i = 1; i < N; i++) ctx.lineTo(d.p[2 * i], d.p[2 * i + 1])
        ctx.closePath()
        ctx.fill()
      }
    }
    const rnd = (a: number, b: number) => a + Math.random() * (b - a)
    // a splash is several drops on the same spot, which nest into rings (ink, water, ink, ...)
    const splash = (x: number, y: number, r: number, k = 2 + Math.floor(Math.random() * 6)) => { for (let i = 0; i < k; i++) drop(x, y, r) }
    const seed = () => { drops.length = 0; n = 0; for (let i = 0; i < 4; i++) splash(rnd(w * 0.15, w * 0.85), rnd(h * 0.2, h * 0.8), rnd(14, Math.min(w, h) * 0.07), 6 + Math.floor(Math.random() * 5)) }

    let last: { x: number; y: number } | null = null, moved = 0
    const at = (e: PointerEvent) => { const r = root.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top } }
    cv.addEventListener('pointerdown', e => { last = at(e); moved = 0; cv.setPointerCapture(e.pointerId) })
    cv.addEventListener('pointermove', e => {
      if (!last) return
      const p = at(e), dx = p.x - last.x, dy = p.y - last.y
      moved += Math.hypot(dx, dy)
      comb(p.x, p.y, dx, dy)
      last = p
    })
    cv.addEventListener('pointerup', e => { if (last && moved < 6) { const p = at(e); splash(p.x, p.y, rnd(12, Math.min(w, h) * 0.07)) } last = null })

    new ResizeObserver(() => { const first = !w; size(); if (first) seed() }).observe(root)
    new IntersectionObserver(es => { visible = es[0].isIntersecting }, { rootMargin: '80px' }).observe(root)
    let t = 0
    const tick = (now: number) => {
      if (visible) {
        if (!calm && !last && now - t > 2600) { t = now; splash(rnd(w * 0.1, w * 0.9), rnd(h * 0.15, h * 0.85), rnd(12, Math.min(w, h) * 0.07)) }
        if (dirty) { draw(); dirty = false }
      }
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  })
</script>
