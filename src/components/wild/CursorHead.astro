---
// A 3D head that turns to follow the cursor, plus a trail of colored grid squares (inspired by githubuniverse.com's footer).
// three.js and the model are loaded only when the section nears the screen. Static when the visitor prefers reduced motion.
// The head is built in code (original, Murakami-ish: flower hair, black-and-white anime eyes), so there is no model file to load.
type Props = { palette?: string }
const { palette = 'neon' } = Astro.props
---

<section class="wild chead" data-palette={palette} aria-label="A head that watches your cursor">
  <div class="grid" aria-hidden="true"></div>
  <canvas aria-hidden="true"></canvas>
</section>

<style is:global>
  .wild.chead { --bg: transparent; background: transparent; min-height: 420px; margin-top: 0; overflow: hidden }
  .wild.chead canvas { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(380px, 80vw); height: min(380px, 80vw); z-index: 2; pointer-events: none }
  .wild.chead .grid { position: absolute; inset: 0; z-index: 1; pointer-events: none }
  .wild.chead .sq { position: absolute; display: grid; place-items: center; font: 700 8px / 1 ui-monospace, Menlo, monospace; color: #0b0b12; opacity: 1 }
  .wild.chead .sq::before { content: ''; position: absolute; inset: 0; margin: auto; width: 100%; height: 100%; background: var(--c); z-index: -1; transition: width .12s ease-in, height .12s ease-in, border-radius .12s ease-in }
  /* last blip: the square shrinks to a colored dot, then goes blank */
  .wild.chead .sq.dot { color: transparent }
  .wild.chead .sq.dot::before { width: 32%; height: 32%; border-radius: 50% }
  .wild.chead .sq.off { opacity: 0; transition: opacity .1s linear 0s }
</style>

<script>
  const PAL: Record<string, string[]> = {
    neon: ['#ae85ff', '#f73678', '#ff8a00', '#583af7', '#5fed83', '#ffe600'],
    pastel: ['#ffd1dc', '#c8e7ff', '#d6ffd1', '#fff3b0', '#e4d1ff', '#ffd9b0'],
    mono: ['#111111', '#444444', '#777777', '#aaaaaa', '#cccccc', '#eeeeee'],
  }
  const CH = ['-', '/', ')', '.', '+', '=', '>', '<', '*', '&', '(']
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('.wild.chead').forEach(root => {
    const colors = PAL[root.dataset.palette ?? 'neon'] ?? PAL.neon
    const gridEl = root.querySelector<HTMLElement>('.grid')!
    const canvas = root.querySelector('canvas')!
    const mouse = { x: 0, y: 0 }

    // ---- fine trail of squares (plain DOM, 90 recycled cells), tracked over the whole page
    const pool = reduce ? [] : Array.from({ length: 90 }, () => { const d = document.createElement('div'); d.className = 'sq off'; gridEl.append(d); return d })
    let n = 0, lx = -1, ly = -1
    const seq = pool.map(() => 0)
    addEventListener('pointermove', e => {
      mouse.x = Math.max(-0.5, Math.min(0.5, e.clientX / innerWidth - 0.5))
      mouse.y = Math.max(-0.5, Math.min(0.5, e.clientY / innerHeight - 0.5))
      if (!pool.length) return
      const r = root.getBoundingClientRect()
      if (e.clientY < r.top || e.clientY > r.bottom) return
      const cell = 14
      const x = Math.floor((e.clientX - r.left) / cell) * cell, y = Math.floor((e.clientY - r.top) / cell) * cell
      if (x === lx && y === ly) return
      lx = x; ly = y
      const d = pool[(n = (n + 1) % pool.length)]
      d.style.cssText = `left:${x}px;top:${y}px;width:${cell}px;height:${cell}px;--c:${colors[Math.floor(Math.random() * colors.length)]}`
      d.textContent = Math.random() < 0.4 ? '' : CH[Math.floor(Math.random() * CH.length)]
      d.classList.remove('off', 'dot')
      const mine = ++seq[pool.indexOf(d)]
      const life = 100 + Math.random() * 300
      setTimeout(() => { if (seq[pool.indexOf(d)] === mine) d.classList.add('dot') }, life)
      setTimeout(() => { if (seq[pool.indexOf(d)] === mine) { d.classList.add('off'); d.textContent = '' } }, life + 220)
    })

    // ---- the head (lazy, built in code)
    new IntersectionObserver(async (es, o) => {
      if (!es[0].isIntersecting) return
      o.disconnect()
      try {
        const T = await import('three')
        const renderer = new T.WebGLRenderer({ canvas, antialias: true, alpha: true })
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
        const scene = new T.Scene()
        const cam = new T.PerspectiveCamera(28, 1, 0.1, 100)
        cam.position.set(0, 0.15, 9)
        scene.add(new T.AmbientLight(0xffffff, 1.6))
        const sun = new T.DirectionalLight(0xffffff, 2.2); sun.position.set(-2, 3, 5); scene.add(sun)

        // 3-step toon shading + thick black outline (inverted hull) for the cel / pop-art look
        const ramp = new T.DataTexture(new Uint8Array([90, 90, 90, 255, 175, 175, 175, 255, 255, 255, 255, 255]), 3, 1, T.RGBAFormat)
        ramp.minFilter = ramp.magFilter = T.NearestFilter; ramp.needsUpdate = true
        const toon = (c: string) => new T.MeshToonMaterial({ color: c, gradientMap: ramp })
        const inkMat = new T.MeshBasicMaterial({ color: 0x0b0b12, side: T.BackSide })
        const mk = (geo: import('three').BufferGeometry, color: string, outline = 0.05) => {
          const g = new T.Group(); g.add(new T.Mesh(geo, toon(color)))
          if (outline) { const ink = new T.Mesh(geo, inkMat); ink.scale.setScalar(1 + outline); g.add(ink) }
          return g
        }
        const sph = new T.SphereGeometry(1, 40, 28)

        const head = new T.Group(); scene.add(head)
        const flat = (c: number, o = 1) => new T.MeshBasicMaterial({ color: c, transparent: o < 1, opacity: o })

        // a Murakami flower: rainbow petals in a ring behind a round face
        const petals = new T.Group(); petals.position.z = -0.45; head.add(petals)
        const cols = ['#ff3d81', '#ff8a00', '#ffe600', '#5fed83', '#2ec4ff', '#ae85ff']
        const N = 12
        for (let i = 0; i < N; i++) {
          const a = (i / N) * Math.PI * 2 + Math.PI / N
          const p = mk(sph, cols[i % cols.length], 0.05)
          p.position.set(Math.cos(a) * 1.75, Math.sin(a) * 1.75, 0); p.scale.set(0.72, 0.72, 0.5); petals.add(p)
        }
        const back = mk(sph, '#ffe600', 0); back.scale.set(1.7, 1.7, 0.4); petals.add(back)

        const face = mk(sph, '#ffe0cc', 0.03); face.scale.set(1.35, 1.35, 1.1); head.add(face)

        // eyes: tall black ovals in a white rim, big white sparkles. Pure black and white.
        const pupils: import('three').Group[] = []
        ;[-1, 1].forEach(sx => {
          const eye = new T.Group(); eye.position.set(sx * 0.5, 0.1, 1.0); eye.rotation.y = sx * 0.28; head.add(eye)
          const rim = new T.Mesh(sph, flat(0x0b0b12)); rim.scale.set(0.37, 0.5, 0.1); eye.add(rim)
          const white = new T.Mesh(sph, flat(0xffffff)); white.scale.set(0.33, 0.46, 0.1); white.position.z = 0.03; eye.add(white)
          const iris = new T.Group(); iris.position.z = 0.1; eye.add(iris); pupils.push(iris)
          const dark = new T.Mesh(sph, flat(0x050508)); dark.scale.set(0.26, 0.38, 0.05); iris.add(dark)
          const s1 = new T.Mesh(sph, flat(0xffffff)); s1.scale.set(0.08, 0.1, 0.05); s1.position.set(-0.08, 0.15, 0.06); iris.add(s1)
          const s2 = new T.Mesh(sph, flat(0xffffff)); s2.scale.set(0.04, 0.05, 0.05); s2.position.set(0.08, -0.14, 0.06); iris.add(s2)
        })

        // blush, tiny nose, open smile with tongue
        ;[-1, 1].forEach(sx => { const ch = new T.Mesh(sph, flat(0xff5c8a, 0.75)); ch.position.set(sx * 0.95, -0.38, 0.78); ch.scale.set(0.2, 0.12, 0.05); ch.rotation.y = sx * 0.9; head.add(ch) })
        const nose = new T.Mesh(sph, flat(0xe0906c)); nose.position.set(0, -0.2, 1.19); nose.scale.set(0.05, 0.035, 0.04); head.add(nose)
        const mouth = new T.Group(); mouth.position.set(0, -0.42, 1.06); head.add(mouth)
        const mo = new T.Mesh(new T.CircleGeometry(0.3, 32, Math.PI, Math.PI), flat(0x2a0a14)); mouth.add(mo)
        const tongue = new T.Mesh(new T.CircleGeometry(0.15, 24, Math.PI, Math.PI), flat(0xff6b8b)); tongue.position.set(0, -0.14, 0.005); tongue.scale.set(1, 0.8, 1); mouth.add(tongue)
        const line = new T.Mesh(new T.PlaneGeometry(0.62, 0.035), flat(0x0b0b12)); line.position.z = 0.01; mouth.add(line)
        const outline = new T.Mesh(new T.RingGeometry(0.3, 0.335, 32, 1, Math.PI, Math.PI), flat(0x0b0b12)); outline.position.z = 0.01; mouth.add(outline)

        const fit = () => { const w = canvas.clientWidth || 380; renderer.setSize(w, w, false); cam.aspect = 1; cam.updateProjectionMatrix() }
        fit(); addEventListener('resize', fit)
        head.scale.setScalar(0.27)
        let visible = true
        new IntersectionObserver(e => (visible = e[0].isIntersecting)).observe(root)
        const draw = () => renderer.render(scene, cam)
        if (reduce) return draw()
        let t = 0
        const tick = () => {
          requestAnimationFrame(tick)
          if (!visible || document.hidden) return
          t += 0.016
          head.rotation.y += (mouse.x * 1.4 - head.rotation.y) * 0.1
          head.rotation.x += (mouse.y * 0.8 - head.rotation.x) * 0.1
          head.position.y = Math.sin(t * 1.6) * 0.06
          pupils.forEach(p => { p.position.x += (mouse.x * 0.35 - p.position.x) * 0.15; p.position.y += (-mouse.y * 0.3 - p.position.y) * 0.15 })
          petals.rotation.z = t * 0.15
          draw()
        }
        tick()
      } catch { /* no WebGL: the squares still work */ }
    }, { rootMargin: '300px' }).observe(root)
  })
</script>
