---
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { allLogs, fmtDate, logUrl } from '../../lib/logs'

const logs = await allLogs()
const tags = [...new Set(logs.flatMap(l => l.data.tags))].sort((a, b) => logs.filter(l => l.data.tags.includes(b)).length - logs.filter(l => l.data.tags.includes(a)).length)
---

<Base title="Logs" description="Tejvir's logs" active="logs">
  <div class="wrap">
    <div class="pagehead"><h1>Logs</h1><p>Tejvir's logs</p></div>
    <section style="margin-top:0">
      <div class="seg" role="group" aria-label="Logs view"><a class="on" href="/logs">Latest</a><a href="/logs/archive">Archive</a></div>
      <div class="chips" id="tags">
        <button class="chip on" data-t="">All <small>{logs.length}</small></button>
        {tags.map(t => <button class="chip" data-t={t}>{t} <small>{logs.filter(l => l.data.tags.includes(t)).length}</small></button>)}
      </div>
      <div class="llist" id="list">
        {logs.map(l => (
          <a href={logUrl(l)} data-tags={l.data.tags.join('|')}>
            <span class="d">{fmtDate(l.data.date)}</span>
            <span><b>{l.data.title}</b><span class="ds">{l.data.description}</span></span>
            <span class="tg">{l.data.tags.map(t => <span>{t}</span>)}</span>
            <span class="th">{l.data.image && <Image src={l.data.image} alt="" width={144} format="webp" quality={60} loading="lazy" />}</span>
          </a>
        ))}
      </div>
      <div class="pager" id="pager"></div>
    </section>
  </div>
</Base>

<style>
  section { margin-top: 0 }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-bottom: 22px }
  .seg a { padding: 8px 14px; font-size: 13px; color: var(--mute) }
  .seg a.on { background: var(--fg); color: var(--bg) }
  #tags { margin-bottom: 18px }
  .llist { border-top: 1px solid var(--line) }
  .llist > a { display: grid; grid-template-columns: 130px 1fr auto 72px; gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: center }
  .llist > a[hidden] { display: none }
  .d { color: var(--mute); font-size: 13px }
  b { font-weight: 600; display: block }
  .llist a:hover b { text-decoration: underline }
  .ds { color: var(--mute); font-size: 13px }
  .tg { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end }
  .tg span { font-size: 11.5px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 99px; color: var(--mute) }
  .th { width: 72px; height: 54px; background: var(--soft); overflow: hidden }
  .th :global(img) { width: 100%; height: 100%; object-fit: cover }
  :global(.pager) { display: flex; gap: 6px; margin-top: 26px; flex-wrap: wrap }
  :global(.pager button) { min-width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; color: var(--mute); padding: 0 10px }
  :global(.pager button.on) { background: var(--fg); color: var(--bg); border-color: var(--fg) }
  @media (max-width: 700px) {
    .llist > a { grid-template-columns: 1fr 64px; gap: 4px 14px }
    .d { grid-column: 1 }
    .tg { display: none }
    .th { grid-row: 1 / 4; grid-column: 2; width: 64px; height: 48px }
  }
</style>

<script>
  const PER = 10
  const rows = [...document.querySelectorAll<HTMLElement>('#list > a')]
  const pager = document.getElementById('pager')!
  let tag = ''
  let page = 1
  function draw() {
    const match = rows.filter(r => !tag || r.dataset.tags!.split('|').includes(tag))
    const pages = Math.ceil(match.length / PER)
    page = Math.min(page, pages || 1)
    rows.forEach(r => (r.hidden = true))
    match.slice((page - 1) * PER, page * PER).forEach(r => (r.hidden = false))
    pager.innerHTML = pages > 1 ? Array.from({ length: pages }, (_, i) => `<button class="${i + 1 === page ? 'on' : ''}" data-p="${i + 1}">${i + 1}</button>`).join('') : ''
    document.querySelectorAll<HTMLElement>('#tags .chip').forEach(c => c.classList.toggle('on', (c.dataset.t ?? '') === tag))
  }
  pager.addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (b) { page = Number(b.dataset.p); draw(); scrollTo(0, 0) } })
  document.getElementById('tags')!.addEventListener('click', e => { const c = (e.target as HTMLElement).closest<HTMLElement>('.chip'); if (c) { tag = c.dataset.t ?? ''; page = 1; draw() } })
  draw()
</script>
