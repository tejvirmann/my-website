---
import { render } from 'astro:content'
import { getImage } from 'astro:assets'
import Base from '../../../layouts/Base.astro'
import { allLogs, fmtDate, logUrl, bodyImages } from '../../../lib/logs'
import { KINDS } from '../../../lib/kinds'
import { listingFor, shopCurrency } from '../../../lib/site'

export async function getStaticPaths() {
  const logs = await allLogs()
  return logs.map((log, i) => ({ params: { slug: log.id }, props: { log, newer: logs[i - 1], older: logs[i + 1] } }))
}
const { log, newer, older } = Astro.props
const { Content } = await render(log)
const d = log.data

// every picture of the log: the cover (optimized here) first, then pictures embedded in the markdown body
type Pic = { src: string; thumb: string; w?: number; h?: number }
const pics: Pic[] = []
if (d.image) {
  const [large, thumb] = await Promise.all([getImage({ src: d.image, width: 1400, format: 'webp', quality: 80 }), getImage({ src: d.image, width: 144, format: 'webp', quality: 60 })])
  pics.push({ src: large.src, thumb: thumb.src, w: d.image.width, h: d.image.height })
}
for (const u of bodyImages(log.body)) pics.push({ src: u, thumb: u })

// frontmatter `defaultPic` (1-based) moves that picture to the front, so it is "1 of N" and what opens first
if (d.defaultPic && d.defaultPic > 1 && d.defaultPic <= pics.length) pics.unshift(...pics.splice(d.defaultPic - 1, 1))

const listing = listingFor(log.id)
const kinds = d.kinds.filter(k => k !== 'favorite').map(k => KINDS[k].label)
const medium = d.kinds.includes('painting') ? 'Paint' : d.kinds.includes('drawing') ? 'Drawing' : d.kinds.includes('writing') ? 'Text' : d.kinds.includes('software') ? 'Software' : d.kinds.includes('research') ? 'Research' : null
---

<Base title={d.title} description={d.description || undefined} active={listing ? 'shop' : 'logs'}>
  <div class="wrap">
    <p class="crumb"><a href="/logs">Logs</a> / {d.title}</p>
    <div class="lp">
      <div class="gal" id="gal" data-pics={JSON.stringify(pics)}>
        <button class="main" id="mn" aria-label="Enlarge picture">
          {pics[0] ? <img src={pics[0].src} width={pics[0].w} height={pics[0].h} alt={d.title} fetchpriority="high" /> : <span class="mute">No picture</span>}
        </button>
        {pics.length > 1 && (
          <div class="th" id="th">
            {pics.map((p, i) => <button class:list={[i === 0 && 'on']} data-i={i} aria-label={`Picture ${i + 1}`}><img src={p.thumb} alt="" loading="lazy" decoding="async" /></button>)}
          </div>
        )}
        {pics.length > 1 && <div class="cnt" id="cn">1 of {pics.length} pictures</div>}
      </div>

      <div class="info">
        <h1>{d.title}</h1>
        <div class="meta">{fmtDate(d.date)}{kinds.length ? ` · ${kinds.join(', ')}` : ''}</div>
        {d.description && <p class="lead">{d.description}</p>}
        <div class="md"><Content /></div>
        {d.repo && <p style="margin:14px 0"><a class="btn" href={d.repo} target="_blank" rel="noopener">View on GitHub →</a></p>}
        <dl class="spec">
          <dt>Year</dt><dd>{d.date.getUTCFullYear()}</dd>
          {medium && <><dt>Medium</dt><dd>{medium}</dd></>}
          {d.lang && <><dt>Language</dt><dd>{d.lang}</dd></>}
          <dt>Pictures</dt><dd>{pics.length}</dd>
        </dl>
        {listing && (
          <div class="buy" id="buy" data-slug={log.id}>
            <div class="price">{new Intl.NumberFormat('en-US', { style: 'currency', currency: shopCurrency.toUpperCase(), maximumFractionDigits: 0 }).format(listing.price)}</div>
            <div class="stock">{listing.stock <= 0 ? 'Sold out' : listing.stock <= 3 ? `Only ${listing.stock} left` : 'In stock'} · shipping calculated at checkout</div>
            <div class="opt" id="opt">{listing.sizes.map((s, i) => <button class:list={[i === 0 && 'on']} data-s={s}>{s}</button>)}</div>
            <button class="btn solid" id="co" disabled={listing.stock <= 0}>Buy with Stripe →</button>
            <p class="msg" id="msg" role="status"></p>
            <p class="mute fine">Payment happens on Stripe's hosted page. Card details never touch this site.</p>
          </div>
        )}
        {d.tags.length > 0 && <div class="tags">{d.tags.map(t => <a href="/logs">{t}</a>)}</div>}
      </div>
    </div>

    <nav class="pn" aria-label="Other logs">
      {newer ? <a href={logUrl(newer)}><small>← Newer</small>{newer.data.title}</a> : <span />}
      {older ? <a href={logUrl(older)} style="text-align:right"><small>Older →</small>{older.data.title}</a> : <span />}
    </nav>
  </div>

  <div class="lbx" id="lbx" role="dialog" aria-modal="true" aria-label="Picture" hidden><img id="lbimg" alt="" /></div>
</Base>

<style>
  .crumb { font-size: 13px; color: var(--mute); margin-top: 24px }
  .crumb a:hover { color: var(--fg) }
  .lp { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); margin-top: 36px; align-items: start }
  .main { width: 100%; background: var(--soft); display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3.4; padding: 4%; cursor: zoom-in }
  .main img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; box-shadow: 0 14px 30px -18px rgba(0, 0, 0, .45) }
  .th { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; padding-bottom: 4px }
  .th button { flex: none; width: 72px; height: 72px; background: var(--soft); display: flex; align-items: center; justify-content: center; border: 1.5px solid transparent; padding: 3px; opacity: .6 }
  .th button.on, .th button:hover { opacity: 1; border-color: var(--fg) }
  .th img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain }
  .cnt { font-size: 12.5px; color: var(--mute); margin-top: 6px }
  .info { position: sticky; top: 78px }
  .info h1 { font: 600 clamp(26px, 3.6vw, 36px) / 1.1 var(--sans); letter-spacing: -.02em }
  .meta { color: var(--mute); margin: 6px 0 14px; font-size: 14px }
  .lead { font-size: 16px; margin-bottom: 14px; max-width: 62ch }
  .spec { display: grid; grid-template-columns: 96px 1fr; gap: 6px 14px; margin: 16px 0; padding: 14px 0; border-block: 1px solid var(--line); font-size: 14px }
  .spec dt { color: var(--mute) }
  .buy { border: 1px solid var(--line); padding: 18px; margin: 18px 0 }
  .price { font: 600 24px var(--sans) }
  .stock { font-size: 13px; color: var(--mute); margin: 2px 0 12px }
  .opt { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 16px }
  .opt button { padding: 8px 13px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px }
  .opt button.on { border-color: var(--fg); box-shadow: inset 0 0 0 1px var(--fg) }
  .buy .btn { width: 100% }
  .msg { font-size: 13px; margin-top: 10px; min-height: 18px }
  .fine { font-size: 12px; margin-top: 8px }
  .tags { display: flex; gap: 6px; flex-wrap: wrap }
  .tags a { font-size: 12px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 99px; color: var(--mute) }
  .pn { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 14px }
  .pn a { max-width: 48% }
  .pn small { display: block; color: var(--mute) }
  .lbx { position: fixed; inset: 0; z-index: 200; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 16px; cursor: zoom-out }
  .lbx[hidden] { display: none }
  .lbx img { max-width: 100%; max-height: 100%; object-fit: contain }
  @media (max-width: 820px) { .lp { grid-template-columns: 1fr; margin-top: 20px } .info { position: static } .main { aspect-ratio: 1 / 1 } }
</style>

<script>
  const gal = document.getElementById('gal')!
  const pics: { src: string; w?: number; h?: number }[] = JSON.parse(gal.dataset.pics!)
  const mn = document.getElementById('mn')!
  const th = document.getElementById('th')
  const cn = document.getElementById('cn')
  const lbx = document.getElementById('lbx')!
  const lbimg = document.getElementById('lbimg') as HTMLImageElement
  let cur = 0
  const show = (n: number) => {
    if (!pics.length) return
    cur = (n + pics.length) % pics.length
    const p = pics[cur]
    mn.innerHTML = `<img src="${p.src}" ${p.w ? `width="${p.w}" height="${p.h}"` : ''} alt="">`
    th?.querySelectorAll('button').forEach((b, j) => b.classList.toggle('on', j === cur))
    if (cn) cn.textContent = `${cur + 1} of ${pics.length} pictures`
  }
  th?.addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (b) show(Number(b.dataset.i)) })
  mn.addEventListener('click', () => { if (!pics.length) return; lbimg.src = pics[cur].src; lbx.hidden = false })
  lbx.addEventListener('click', () => (lbx.hidden = true))
  addEventListener('keydown', e => {
    if (e.key === 'Escape') lbx.hidden = true
    if (e.key === 'ArrowRight') show(cur + 1)
    if (e.key === 'ArrowLeft') show(cur - 1)
  })
  // swipe the main picture on touch screens
  let sx = 0
  mn.addEventListener('touchstart', e => { sx = e.touches[0].clientX }, { passive: true })
  mn.addEventListener('touchend', e => { const d = e.changedTouches[0].clientX - sx; if (Math.abs(d) > 50) show(cur + (d < 0 ? 1 : -1)) })

  // buy box
  const buy = document.getElementById('buy')
  if (buy) {
    const opt = document.getElementById('opt')!
    const msg = document.getElementById('msg')!
    opt.addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) opt.querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)) })
    document.getElementById('co')!.addEventListener('click', async () => {
      msg.textContent = 'Opening checkout…'
      try {
        const r = await fetch('/api/checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: buy.dataset.slug, size: opt.querySelector('.on')?.getAttribute('data-s') }) })
        const j = await r.json()
        if (j.url) location.href = j.url
        else msg.textContent = j.error || 'Checkout is not available yet.'
      } catch { msg.textContent = 'Checkout is not available yet.' }
    })
  }
</script>
