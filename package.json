{
  "name": "my-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "meta": "node scripts/art-meta.mjs",
    "predev": "npm run meta",
    "dev": "astro dev",
    "prebuild": "npm run meta",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.2",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
